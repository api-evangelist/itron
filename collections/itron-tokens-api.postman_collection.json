      "item": [
        {
          "id": "53196e87-2a36-48c0-84ce-5411ab56eef4",
          "name": "Issue Short-Lived Bearer Token",
          "request": {
            "name": "Issue Short-Lived Bearer Token",
            "description": {
              "content": "Exchange client credentials for a short-lived bearer token suitable for use\nin a browser. Per SDK docs: \"You can get a token directly from the Tokens API\nusing valid credentials. This token is suitable for use in a browser as it\nis short lived.\"\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"<string>\",\n  \"clientSecret\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
